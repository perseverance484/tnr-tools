 "_ratified_2026-08-27": {
  "_class": "ratified",
  "by": "dauntless",
  "date": "2026-08-27",
  "quest_fields": {
   "source": "measured, unanimous across all 50 live mission records (maxLevel unanimous at B/A/S, 64-76% dominant at D/C with no competing value)",
   "fields": [
    "attemptDelay",
    "maxAttempts",
    "maxCompletes",
    "maxLevel",
    "retryDelay"
   ]
  },
  "shape_fields": {
   "source": "dauntless 2026-08-27: derive shape from OUR content only. Legacy records excluded - the ten A duplicates, the four 49-objective S records and the thirteen legacy C stubs outvote our own work and would have encoded the defect.",
   "populations": {
    "D": "14 records, all ours",
    "C": "4 Blacksteel Contracts",
    "B": "2 records, Copies and Witness Detail, ratified as the B standard"
   },
   "weakest": "B objective_count 23 and battle_nodes 3 are means of n=2. There is no mode at n=2 and these are the least evidenced filled values in this file."
  },
  "requiredLevel": {
   "source": "dauntless 2026-08-27, given as a table",
   "values": {
    "D": 3,
    "D_story": 5,
    "D_combat": 20,
    "C": 20,
    "B": 25,
    "A": 50,
    "S": "deferred"
   }
  },
  "A_scale": "dauntless 2026-08-27: A is twice B. objective_count 46 and battle_nodes 6 are 2x B's 23 and 3. enemies_per_battle stays 1, INHERITED not doubled - the ruling was about depth, outcomes and story, and per-battle headcount is a separate call.",
  "D_default": "dauntless 2026-08-27: D has no combat by default. Future D missions are built no-combat; the six live combat Ds are deliberate exceptions.",
  "enemy_level_band": {
   "_class": "ratified",
   "by": "dauntless",
   "date": "2026-08-27",
   "given": "10-25 D, 25-40 C, 40-55 B, 55+ A",
   "bands": {
    "D": [
     10,
     25
    ],
    "D_story": [
     10,
     25
    ],
    "D_combat": [
     10,
     25
    ],
    "C": [
     25,
     40
    ],
    "B": [
     40,
     55
    ],
    "A": [
     55,
     100
    ]
   },
   "supersedes": "the measured bands derived earlier the same day (D_combat [10,27], C [10,15], B [40,55]). The measurement is retained below only as the reason the ladder was re-ruled: it was not monotonic, C fought easier enemies than D at the same required level, and B jumped a cliff.",
   "A_ceiling": "55+ was given open-ended. Written as [55, 100] because LVL_CAP is 100 and mission.py needs a two-element band; the ceiling is an inference, not a ruling.",
   "no_combat_D": "D and D_story carry the band even though battle_nodes is 0. A band costs nothing when there is no roster (resolve_enemy_level is never called) and bounds the case where someone later adds one. Null would have accepted any level silently.",
   "live_content_now_outside_its_band": [
    "Syndicate Thief lvl 27 on Night Watch Shadow (D) - one over the new ceiling of 25.",
    "KGK Rogue 10, KGK Obelisk 15, KX: Iron Aberration 15 - all four Blacksteel C contracts now sit BELOW the C band of 25-40. The profile governs new builds, so nothing breaks, but our existing C content is under-tuned against the ratified ladder."
   ]
  },
  "encounter_doctrine": {
   "_class": "ratified",
   "by": "dauntless",
   "date": "2026-08-27",
   "rule": "Route and choice change WHO the player fights and HOW MANY. Going loud, or taking the wrong way in the dark, escalates both. C introduces ambushes; D does not.",
   "max_enemies_per_battle": {
    "D": 1,
    "D_story": 1,
    "D_combat": 1,
    "C": 2,
    "B": 3,
    "A": 4
   },
   "why_a_ceiling_not_a_value": "enemies_per_battle stays the DEFAULT the auto-wirer applies when a sheet node names no opponents. The variation is authored per node in the sheet, because a single profile scalar cannot say 'the roof is one Fleetfoot and the front door is two Ironfoots'. mission.py enforces the ceiling on the SUMMED headcount of each battle node.",
   "D_caps_proposed": "D at 1 is PROPOSED, not given. dauntless ruled ambushes start at C and said nothing about D; a D_combat fight is a single enemy today."
  }
 },
