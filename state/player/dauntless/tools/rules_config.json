    {"id": "locked_stack",  "weight": 88,  "when": "stack_clearprevented", "bundles": [["fury", "shield"], ["danse", "shield"], ["fury", "subaku"]]},
    {"id": "recoil_me",     "weight": 80,  "when": "recoil_on_me",       "bundles": [["cleanse", "panacea", "jewel"], ["stormblade", "overflow"], ["nights", "overflow", "panacea"]]},
    {"id": "anti_heal",     "weight": 78,  "when": "en_sustain",         "bundles": [["severed", "stormblade"], ["severed", "nights", "pill"], ["severed", "eclipse", "pill"]]},
    {"id": "pierce_dr",     "weight": 75,  "when": "en_dr_or_shield",    "bundles": [["stormblade", "aetherion"], ["nights", "phantom", "pill"]]},
    {"id": "cleanse",       "weight": 72,  "when": "me_debuffed",        "bundles": [["cleanse", "panacea", "jewel"], ["cleanse", "pill", "kunai"]]},
    {"id": "reflect",       "weight": 65,  "when": "en_reflect",         "bundles": [["clear", "overflow"], ["shield", "eclipse", "panacea"]]},
    {"id": "building",      "weight": 60,  "when": "stack_building",     "bundles": [["fury", "sealnull"], ["fury", "shield"], ["sealnull", "shield", "defstance"]]},
    {"id": "absorb_up",     "weight": 50,  "when": "my_absorb_down",     "bundles": [["rebirth", "thunders"], ["shield", "eclipse", "pill"]]},
    {"id": "setup",         "weight": 40,  "when": "always",             "bundles": [["ember", "overflow"], ["rebirth", "overflow"], ["shrapnel", "thunders"], ["ember", "eclipse"]]}
