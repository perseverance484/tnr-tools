       "keepOriginalPools": false,
       "nextObjectiveId": "jelly_o2",
       "failObjectiveId": "jelly_f1"
      },
      {
       "task": "dialog",
       "image": "",
       "description": "<i>A numbing sting catches you before you can break away. You retreat above the tide line as the jellyfish sinks back into the surf.</i> <br> <br> It does not pursue. The creature simply waits in the shallows, pulsing with cold blue light.",
       "successDescription": "",
       "sceneBackground": "Pz52vtn130CkDPjUjhPvN",
       "sceneCharacters": [],
       "attackers": [],
       "attackers_scale_gains": 1,
