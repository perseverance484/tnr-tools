   "data": {
    "name": "The Buried Cache",
    "description": "Before the Skyglass warship vanished, its crew buried a field cache on the shore. The Wayfinder corrected the route to it again and again as the coast changed. This chart carries his last correction. Lose a fight and the tide takes the dig, chart and all.",
    "image": "@img:icon-chart-drowned-foundry.webp",
    "questType": "battlepyramid",
    "questRank": "B",
    "successDescription": "You dug up the Skyglass crew's field cache.",
    "retryDelay": "none",
    "attemptDelay": "none",
    "consecutiveObjectives": true,
    "hidden": true,
    "requiredLevel": 1,
    "maxLevel": 100,
    "maxAttempts": 100,
    "maxCompletes": 100,
    "prerequisiteQuestId": null,
    "tierLevel": null,
    "requiredVillage": null,
    "requiredBloodlineId": null,
    "startsAt": null,
    "endsAt": null,
    "content": {
     "objectives": [
      {
       "id": "d_landing",
       "task": "dialog",
       "description": "The chart's route ends on a quiet stretch of coast. Among the ship's impossible routes it marks an old field cache, buried before the ship vanished. The ink is decades old. The Wayfinder's newest corrections are not.",
       "sceneBackground": "https://ui0arpl8sm.ufs.sh/f/Hzww9EQvYURJyX6gwPukVH2MI5Lo4ehEfAXvZdcmtWqPg7rp",
       "sceneCharacters": [],
       "nextObjectiveId": [
        {
         "text": "Follow the corrected route",
         "nextObjectiveId": "d_riddle"
        },
        {
         "text": "Compare the old and new routes",
         "nextObjectiveId": "d_overlay"
        }
       ]
      },
      {
       "id": "d_overlay",
       "task": "dialog",
       "description": "Under the first route lies a map of places that did not yet exist when the ship vanished. The Wayfinder corrected the same journey again and again as villages moved, roads changed, and generations passed. The cache is real, but the final clue must be read against the newest chart.",
       "sceneBackground": "https://ui0arpl8sm.ufs.sh/f/Hzww9EQvYURJyX6gwPukVH2MI5Lo4ehEfAXvZdcmtWqPg7rp",
       "sceneCharacters": [],
       "nextObjectiveId": [
        {
         "text": "Follow the corrected route",
         "nextObjectiveId": "d_riddle"
        }
       ]
      },
      {
       "id": "d_riddle",
       "task": "dialog",
       "description": "A notation along the route sheet reads: 'Where the cliff drinks and the stone keeps watch, the cache sleeps beneath the watcher's shadow.' Three coves match part of the description.",
       "sceneBackground": "https://ui0arpl8sm.ufs.sh/f/Hzww9EQvYURJyX6gwPukVH2MI5Lo4ehEfAXvZdcmtWqPg7rp",
       "sceneCharacters": [],
       "nextObjectiveId": [
        {
         "text": "The cove beneath the stone shrine",
         "nextObjectiveId": "d_dig"
        },
        {
         "text": "The cove with the split cliff",
         "nextObjectiveId": "d_wrong1"
        },
        {
         "text": "The open beach past the reef",
         "nextObjectiveId": "d_wrong2"
        }
       ]
      },
      {
       "id": "d_wrong1",
       "task": "dialog",
       "description": "You dig where the split cliff breaks the tide. Beneath the sand you find old seal fragments, and the fragments wake: a Deck Warden pulls itself out of the sand with a seal charge still burning in its hook.",
       "sceneBackground": "https://ui0arpl8sm.ufs.sh/f/Hzww9EQvYURJyX6gwPukVH2MI5Lo4ehEfAXvZdcmtWqPg7rp",
       "sceneCharacters": [],
