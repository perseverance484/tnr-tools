  {
   "entity": "quest",
   "slot": "edit",
   "targetId": "YDmKO6fp2vBRnTf7fHWQZ",
   "name": "The Mother of Echoes (Practice): dialog portraits",
   "data": {
    "name": "The Mother of Echoes (Practice)",
    "description": "Test fight for The Mother of Echoes. The same three battles against the same enemies and the same rewards, with no shards needed. Health, chakra and stamina carry between battles with no refills, as in the real fight.",
    "successDescription": "The Mother Glass cracks from the root to the crown. Choose your reward.",
    "image": "@img:icon-quest-mother-of-echoes.webp",
    "questType": "battlepyramid",
    "questRank": "S",
    "hidden": true,
    "retryDelay": "none",
    "attemptDelay": "none",
    "consecutiveObjectives": true,
    "requiredLevel": 1,
    "maxLevel": 100,
    "maxAttempts": 100,
    "maxCompletes": 100,
    "prerequisiteQuestId": null,
    "tierLevel": null,
    "requiredVillage": null,
    "requiredBloodlineId": null,
    "startsAt": null,
    "endsAt": null,
    "content": {
     "objectives": [
      {
       "id": "d_intro1",
       "task": "dialog",
       "description": "<i>Test run.</i> No shards are needed.<br><br>The four shards fit together in your hands, and the seams vanish. They were never broken. They were an invitation.<br><br>They pull you down, past where Crownhold's stair ends, into a hall of glass. Every pane holds a face. The Deck Warden. The Captain, twice: once bareheaded, once crowned. The guards you cut down. Their eyes are open, and none of them blink.",
       "sceneBackground": "5emzv4rAEFL2iE6Vg5Znm",
       "sceneCharacters": [
        "Bph7t93QYpZqQkYM3N2Yr"
       ],
       "nextObjectiveId": [
        {
         "text": "Go deeper",
         "nextObjectiveId": "d_intro2"
        }
       ]
      },
      {
       "id": "d_intro2",
       "task": "dialog",
       "description": "She hangs in the air before the Mother Glass, her fan open behind her like a halo.<br><br>\"Lovely, aren't they? Every one of them held still for me.\" She smiles at the faces. \"The ship, the castle, all of it. I never lost them. I kept them.\" She inclines her head, as if you had asked. \"Sayo. I grew the glass.\"<br><br>\"And you have been cutting them out of my glass, one by one. How interesting.\"",
       "sceneBackground": "5emzv4rAEFL2iE6Vg5Znm",
       "sceneCharacters": [
        "Bph7t93QYpZqQkYM3N2Yr"
       ],
       "nextObjectiveId": [
        {
         "text": "You did this",
         "nextObjectiveId": "d_open"
        }
       ]
      },
      {
       "id": "d_open",
       "task": "dialog",
       "description": "She studies you the way she studied them. \"There is room in the glass for one more.\"<br><br>She turns to the wall, as if choosing a place for you. Her shadow does not turn with her. It stays where it was. Then it stands up off the floor.",
       "sceneBackground": "5emzv4rAEFL2iE6Vg5Znm",
       "sceneCharacters": [
        "Bph7t93QYpZqQkYM3N2Yr"
       ],
       "nextObjectiveId": [
        {
         "text": "Step into the hall",
         "nextObjectiveId": "b_act1"
        }
       ]
      },
      {
       "id": "b_act1",
       "task": "start_battle",
       "description": "Act I: The Glasswright and the Deep",
       "sceneBackground": "5emzv4rAEFL2iE6Vg5Znm",
       "sceneCharacters": [],
       "opponentAIs": [
        {
         "ids": [
          "fJLcH1mpB1XHHGtNWwvzD"
         ],
         "number": 1,
         "quantity": 1
        },
        {
         "ids": [
          "IhNR-W1FElTsrWw1KfuQ9"
         ],
         "number": 1,
         "quantity": 1
        }
       ],
       "completionOutcome": "Win",
       "scaleGains": 1,
       "keepOriginalPools": false,
       "opponent_scaled_to_user": false,
       "nextObjectiveId": "d_act2",
       "failObjectiveId": "f_lost",
       "failDescription": "Practice over.",
       "drawDescription": "Practice over.",
       "fleeDescription": "Practice over."
      },
      {
       "id": "d_act2",
       "task": "dialog",
       "description": "The deep goes quiet, but the glass does not. Sayo wipes a line of light from her sleeve. \"You read patterns well. Let us see how well you remember them.\"",
       "sceneBackground": "aleMvSlyXGMaT0UGWmJh-",
       "sceneCharacters": [
        "_TB450VtYNqiCLc393Sq4"
       ],
       "nextObjectiveId": [
        {
         "text": "Hold your ground",
         "nextObjectiveId": "b_act2"
        }
       ]
      },
      {
       "id": "b_act2",
       "task": "start_battle",
       "description": "Act II: The Stilling",
       "sceneBackground": "aleMvSlyXGMaT0UGWmJh-",
       "sceneCharacters": [],
       "opponentAIs": [
        {
         "ids": [
          "H3pNj2qUWpMpVRINiH6Vn"
         ],
         "number": 1,
         "quantity": 1
        }
       ],
       "completionOutcome": "Win",
       "scaleGains": 1,
       "keepOriginalPools": false,
       "opponent_scaled_to_user": false,
       "nextObjectiveId": "d_act3",
       "failObjectiveId": "f_lost",
       "failDescription": "Practice over.",
       "drawDescription": "Practice over.",
       "fleeDescription": "Practice over."
      },
      {
       "id": "d_act3",
       "task": "dialog",
       "description": "Every pane in the hall turns toward you. The dark at the edge of the light folds itself small and slides back across the floor into Sayo's shadow. Her eyes close. When she speaks again, nothing moves her lips. \"Hold still. You will make for a good impression.\"",
       "sceneBackground": "dXiE-NNZymwmOgceZfkmb",
       "sceneCharacters": [
        "9a_5ly9kwKB95FCQRwI1s"
       ],
       "nextObjectiveId": [
        {
         "text": "Do not hold still",
         "nextObjectiveId": "b_act3"
        }
       ]
      },
      {
       "id": "b_act3",
       "task": "start_battle",
       "description": "Act III: A Good Impression",
       "sceneBackground": "dXiE-NNZymwmOgceZfkmb",
