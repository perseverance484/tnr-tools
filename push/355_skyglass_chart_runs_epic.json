      {
       "id": "b1",
       "task": "start_battle",
       "description": "The Deck Warden turns from his buckets. Behind him, the planks begin to glow.",
       "sceneBackground": "https://ui0arpl8sm.ufs.sh/f/Hzww9EQvYURJcoxkatSnxBpQqGNDcTHbLmYz8uXAl3oa54ti",
       "sceneCharacters": [],
       "opponentAIs": [
