       "scaleGains": 1,
       "keepOriginalPools": false,
       "opponent_scaled_to_user": false,
       "nextObjectiveId": "d_break",
       "failObjectiveId": "f_lost",
       "failDescription": "You are defeated.",
       "drawDescription": "The fight stalls, and the chart's way closes.",
       "fleeDescription": "You break away, and the way back closes behind you."
      },
      {
       "id": "d_break",
       "task": "dialog",
       "description": "The Keeper falls across his ledger. The last line reads: <i>Ship. Spent.</i><br><br>Below you the keel splits with a sound like a bell, and through the break you can see the Core, cracking open.",
       "sceneBackground": "https://ui0arpl8sm.ufs.sh/f/Hzww9EQvYURJTdaBvI5IU29dZYJPoOKSh5vmlqatMub3EigH",
