    "content": {
     "objectives": [
      {
       "id": "d_open",
       "task": "dialog",
       "description": "<i>Test run.</i> No shards are needed.<br><br>The four shards fit together in your hands, and the seams vanish. They were never broken. They were an invitation.<br><br>Under Crownhold the Mother Glass is singing. Sayo hangs in the air before it, her hair drifting as if the hall were full of water, her fan open behind her like a halo. \"You came. Good. I was beginning to think I had measured you wrong.\"<br><br>She turns to face you. Her shadow does not turn with her. It stays where it was. Then it stands up off the floor, and keeps standing.",
       "sceneBackground": "5emzv4rAEFL2iE6Vg5Znm",
       "sceneCharacters": [],
       "nextObjectiveId": [
        {
         "text": "Step into the hall",
         "nextObjectiveId": "b_act1"
        }
       ]
      },
