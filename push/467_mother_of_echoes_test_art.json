       "drawDescription": "Practice over.",
       "fleeDescription": "Practice over."
      },
      {
       "id": "d_act2",
       "task": "dialog",
       "description": "The deep goes quiet, but the glass does not. Sayo wipes a line of light from her sleeve. \"You read patterns well. Let us see how well you remember them.\"",
       "sceneBackground": "aleMvSlyXGMaT0UGWmJh-",
