       "fleeDescription": "Practice over."
      },
      {
       "id": "d_act3",
       "task": "dialog",
       "description": "Every pane in the hall turns toward you. The dark at the edge of the light folds itself small and slides back across the floor into Sayo's shadow. Her eyes close. When she speaks again, nothing moves her lips. \"Hold still. You will make for a good impression.\"",
       "sceneBackground": "dXiE-NNZymwmOgceZfkmb",
       "sceneCharacters": [],
       "nextObjectiveId": [
        {
         "text": "Do not hold still",
